# Copy to .env.local for local use. On Vercel, add these under Project → Settings → Environment Variables.
# Never commit real values.

# Postgres connection. On Supabase use the "Transaction pooler" URI (port 6543).
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Random secret for signing your login session (at least 32 characters).
# Generate one: openssl rand -hex 32   (or any password manager's generator)
AUTH_SECRET=

# The single owner password used to sign in to AVI (12+ characters).
AVI_OWNER_PASSWORD=

# AI provider for idea interpretation (optional — the app works without it).
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# Or use OpenAI instead (AI_MODEL is then required):
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=

# Time zone for "today" on the dashboard.
APP_TIMEZONE=Australia/Hobart
